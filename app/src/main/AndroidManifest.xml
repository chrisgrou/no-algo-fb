<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the in-app updater install a newly downloaded APK without the user
         having to hunt down "install unknown apps" in system settings first. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Needed only up to API 28 to insert into MediaStore.Images at all — API 29+'s
         scoped storage lets any app write its own MediaStore entries without it, and
         declaring it there would just be a permission the user never needs to grant. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.FbFeedWrapper">

        <!-- configChanges lists every config change we can possibly handle ourselves,
             not just rotation: an unlisted one destroys and recreates the Activity, and
             a recreated Activity means a new WebView reloading the feed from scratch —
             the user lands back at the top on fresh content. uiMode is the one that
             actually bites in normal use (the system flipping to night mode while the
             app sits in the background), with density/fontScale/locale close behind.
             Nothing here reads a configuration-dependent resource that would need the
             recreation, so handling them all is safe. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation|touchscreen|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/Theme.FbFeedWrapper">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Lets the app show up as a handler for a Facebook link tapped anywhere
                 else on the phone (another app, a text message, ...), same as the
                 official Facebook app or a browser would. No android:autoVerify: that
                 needs a verification file hosted at https://<host>/.well-known/
                 assetlinks.json, which only Facebook itself could publish — without
                 it, Android shows this app in the "Open with" chooser (or as the
                 always-on default once the user picks it there, or via Settings → Apps
                 → this app → Set as default → Add link) rather than claiming the link
                 automatically. onNewIntent in MainActivity is what actually loads the
                 tapped URL once the app opens. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="facebook.com" />
                <data android:host="www.facebook.com" />
                <data android:host="m.facebook.com" />
                <data android:host="mobile.facebook.com" />
                <data android:host="touch.facebook.com" />
                <data android:host="fb.me" />
                <data android:host="fb.watch" />
            </intent-filter>
        </activity>

        <!-- Exposes the downloaded update APK (private app cache) to the system
             package installer via a content:// Uri, since installers can't be
             handed a file:// path directly on API 24+. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
